# 依赖与缓存（clone 后执行 pnpm install 重建）
node_modules/
.pnpm-store/

# 构建与测试中间产物（dist/ 是提交进仓库的构建产物，故意不忽略）
.tmp-build/
tools/tmp/
.edge-*/

# 浏览器预览打包产物（由 pnpm preview:build 生成，需要时再构建）
preview/dist/

# 派生的发包（由 pnpm pack:release 生成；正式分发走 GitHub Releases）
release/
submit/

# 系统与编辑器文件
*.local
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# 本地环境变量
.env
.env.local
